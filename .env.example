# Registrator ofisi axborot tizimi konfiguratsiya namunasi

PROJECT_NAME="Registrator ofisi murojaatlar va navbat axborot tizimi"
VERSION="1.0.0"
API_V1_STR="/api/v1"

# Xavfsizlik sozlamalari (Ishlab chiqarishda murakkab kalit bilan almashtiring)
SECRET_KEY="your-strong-secret-key-change-in-production"
ALGORITHM="HS256"
STUDENT_TOKEN_EXPIRE_MINUTES=2880  # 2 kun (48 soat)
STAFF_TOKEN_EXPIRE_MINUTES=720     # 12 soat

# Ma'lumotlar bazasi (SQLite yoki PostgreSQL)
DATABASE_URL="sqlite+aiosqlite:///./roffice.db"
# PostgreSQL uchun namuna:
# DATABASE_URL="postgresql+asyncpg://postgres:password@localhost:5432/roffice"

# Ish vaqti parametrlari
WORK_START_HOUR=9
WORK_END_HOUR=17
LUNCH_START_HOUR=13
LUNCH_END_HOUR=14

# HEMIS tizimi integratsiyasi
HEMIS_BASE_URL="https://student.jbnuu.uz/rest/v1"
HEMIS_TIMEOUT_SECONDS=10

# Telegram Bot sozlamalari
TELEGRAM_BOT_TOKEN="YOUR_TELEGRAM_BOT_TOKEN_HERE"
TELEGRAM_BOT_USERNAME="your_telegram_bot_username"

# HEMIS telefon validatsiyasi
JBNUU_VALIDATE_PHONE_URL="https://student.jbnuu.uz/rest/v1/data/validate-phone"
JBNUU_API_TOKEN="YOUR_HEMIS_API_TOKEN_HERE"
